# ─── AgentGuard Frontend Environment (apps/web) ───────────────────────────────
#
# Copy to apps/web/.env.local for local overrides if needed.
# In production, set VITE_API_URL in the Vercel project settings dashboard.
#
# LOCAL DEVELOPMENT:
#   VITE_API_URL=http://localhost:8000
#   (Locally this can remain localhost, or leave unset to rely on Vite proxy /api -> http://localhost:8000)
#
# PRODUCTION VERCEL:
#   Must set VITE_API_URL to your deployed Render backend Web Service URL, e.g.:
#   VITE_API_URL=https://agentguard-api.onrender.com
#
# SECURITY WARNING:
#   NEVER put Gemini API keys, Razorpay secret keys (RAZORPAY_KEY_SECRET),
#   or AgentGuard signing secrets in VITE_* variables.
#   Only public/non-sensitive values such as VITE_API_URL belong in frontend env variables.
# ──────────────────────────────────────────────────────────────────────────────

VITE_API_URL=http://localhost:8000
