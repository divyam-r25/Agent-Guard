
# ─── LLM Configuration ───
# Used by: Intent Compiler (NL → Intent Contract), Context Firewall (classifier)
# If not set: uses deterministic rule-based fallback
LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.0-flash

# ─── Razorpay Test Mode ───
# IMPORTANT: Use TEST keys only (rzp_test_*). Never use live keys.
# If not set: uses mock payment provider (no network calls)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_test_secret_here

# ─── Server ───
PORT=8000
FRONTEND_URL=http://localhost:5173


USE_MOCK_PAYMENTS=true
USE_MOCK_LLM=false

# ─── Authorization Token ───
# HMAC secret for signing authorization tokens. REQUIRED in production.
# In development, a fallback secret is used if not set.
# Generate a secure value with: openssl rand -hex 32
AUTH_TOKEN_SECRET=your_auth_token_secret_here
