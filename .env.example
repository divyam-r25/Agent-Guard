# ─────────────────────────────────────────────────────────────────
# AgentGuard Environment Configuration
# Copy this file to .env and fill in your values.
# All values are OPTIONAL — AgentGuard has working fallbacks for all.
# ─────────────────────────────────────────────────────────────────

# ─── LLM Configuration ───
# Used by: Intent Compiler (NL → Intent Contract), Context Firewall (classifier)
# If not set: uses deterministic rule-based fallback
LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.0-flash

# ─── Razorpay Test Mode ───
# IMPORTANT: Use TEST keys only (rzp_test_*). Never use live keys.
# If not set: uses mock payment provider (no network calls)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_test_secret_here

# ─── Server ───
PORT=8000
FRONTEND_URL=http://localhost:5173

# ─── Feature Flags ───
# USE_MOCK_PAYMENTS=true  → Skip Razorpay API calls, simulate orders locally
# USE_MOCK_LLM=false      → When false + LLM_API_KEY is set, uses live Gemini
USE_MOCK_PAYMENTS=true
USE_MOCK_LLM=false
